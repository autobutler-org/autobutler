    "paths": {
        "/cirrus": {
            "get": {
                "description": "merges files across all managed devices for the given filePath. If deviceSerial is empty, list files across all devices. Otherwise, only for the specified device",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cirrus"
                ],
                "summary": "merges files across all managed devices for the given filePath",
                "parameters": [
                    {
                        "type": "string",
                        "description": "File path to list",
                        "name": "filePath",
                        "in": "path"
                    },
                    {
                        "type": "string",
                        "description": "Device serial number to filter by",
                        "name": "serial",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/v1_files.FileNodeJSON"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/serverutil.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "serverutil.ContentType": {
            "type": "string",
            "enum": [
                "text/html",
                "application/json"
            ],
            "x-enum-varnames": [
                "ContentTypeHTML",
                "ContentTypeJSON"
            ]
        },
        "serverutil.Response": {
            "type": "object",
            "properties": {
                "contentType": {
                    "$ref": "#/definitions/serverutil.ContentType"
                },
                "data": {},
                "error": {},
                "statusCode": {
                    "type": "integer"
                }
            }
        },
        "v1_files.FileNodeJSON": {
            "type": "object",
            "properties": {
                "deviceName": {
                    "type": "string"
                },
                "devicePath": {
                    "type": "string"
                },
                "deviceSerial": {
                    "type": "string"
                },
                "fullPath": {
                    "type": "string"
                },
                "isDir": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "size": {
                    "type": "integer"
                }
            }
        }
    }

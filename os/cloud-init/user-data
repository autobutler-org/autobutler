#cloud-config
#
# This file is for the CLOUD-INIT approach only.
# Use this when starting from a stock Ubuntu Server image that does NOT have
# AutoButler pre-installed. The first-boot script downloads and installs the
# AutoButler binary at boot time (requires internet access).
#
# If you are using the pre-built custom image (autobutler-pi4.img.xz or
# autobutler-pi5.img.xz from GitHub Releases), you do NOT need this file.
# The binary is already baked into that image — no download happens at boot.
#
# See os/README.md for the difference between these two approaches.

hostname: autobutler
manage_etc_hosts: true

users:
  - default

package_update: true
package_upgrade: true

packages:
  - avahi-daemon
  - ufw
  - udisks2
  - curl
  - jq

write_files:
  - path: /etc/systemd/system/autobutler.service
    permissions: "0644"
    content: |
      [Unit]
      Description=AutoButler Service
      After=network.target

      [Service]
      User=autobutler
      Group=autobutler
      ExecStart=/usr/local/bin/autobutler serve
      Environment="PORT=80"
      Environment="GIN_MODE=release"
      Restart=always
      StandardOutput=append:/var/log/autobutler.app
      StandardError=append:/var/log/autobutler.err

      [Install]
      WantedBy=multi-user.target

  - path: /etc/sudoers.d/autobutler
    permissions: "0440"
    content: |
      autobutler ALL=(root) NOPASSWD: /bin/mount * /var/lib/autobutler/mounts/*, /bin/umount /var/lib/autobutler/mounts/*

  - path: /usr/local/bin/autobutler-first-boot.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      LOG="/var/log/autobutler-setup.log"
      exec > >(tee -a "$LOG") 2>&1

      echo "=== AutoButler first-boot setup started at $(date -u) ==="

      ARCH=$(dpkg --print-architecture)
      echo "Detected architecture: $ARCH"

      echo "Fetching latest release from GitHub..."
      RELEASE_URL=$(curl -fsSL https://api.github.com/repos/autobutler-org/autobutler/releases/latest \
        | jq -r ".assets[] | select(.name | test(\"linux-${ARCH}\")) | .browser_download_url")

      if [ -z "$RELEASE_URL" ]; then
        echo "ERROR: Could not find a release asset for linux-${ARCH}"
        exit 1
      fi

      echo "Downloading AutoButler from: $RELEASE_URL"
      curl -fsSL -o /usr/local/bin/autobutler "$RELEASE_URL"
      chmod 755 /usr/local/bin/autobutler

      echo "Creating service user..."
      if ! id autobutler &>/dev/null; then
        useradd --system --no-create-home --shell /usr/sbin/nologin --comment "AutoButler service account" autobutler
      fi

      echo "Creating data directory..."
      mkdir -p /var/lib/autobutler
      chown -R autobutler:autobutler /var/lib/autobutler

      echo "Configuring firewall..."
      ufw default deny incoming
      ufw default allow outgoing
      ufw allow 80/tcp comment "AutoButler web UI"
      ufw --force enable

      echo "Enabling services..."
      systemctl daemon-reload
      systemctl enable --now avahi-daemon
      systemctl enable --now autobutler

      echo "=== AutoButler first-boot setup completed at $(date -u) ==="
      echo "Access AutoButler at http://autobutler.local"

runcmd:
  - /usr/local/bin/autobutler-first-boot.sh

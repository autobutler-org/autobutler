# Tailscale Configuration
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxx
TAILSCALE_HOSTNAME=autobutler-node

# Tailscale Control Server (leave as default for regular Tailscale)
TAILSCALE_CONTROL_URL=https://controlplane.tailscale.com

# Optional: State directory for Tailscale data
TAILSCALE_STATE_DIR=/var/lib/tailscale

# Server Configuration
WEBUI_PORT=8443

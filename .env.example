# App Store Connect API (iOS uploads via `make publish/frontend/ios`)
# Create a Team Key with the "App Manager" role at
# https://appstoreconnect.apple.com/access/integrations/api
# then save the downloaded .p8 as
#   ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
APP_STORE_CONNECT_KEY_ID=your-key-id
APP_STORE_CONNECT_ISSUER_ID=your-issuer-id

# Google Play Developer API (Android uploads via `make publish/frontend/android`)
# Create a service account with a JSON key in the Google Cloud project linked to the
# Play Console, enable the Google Play Android Developer API, grant it "Release manager"
# in Play Console > Users and permissions, then save the key as
#   ~/.config/quark/play-service-account.json
# Set this only if the file cannot live at that path.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

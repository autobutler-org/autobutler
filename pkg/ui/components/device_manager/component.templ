package device_manager

import (
	"autobutler/pkg/util/cirrusutil"
	"fmt"
)

// Component renders a device management interface showing all detected devices
// and allowing users to initialize them for autobutler
templ Component(devices []cirrusutil.Device, managedDevices []cirrusutil.ManagedDevice) {
	{{ managedMap := make(map[string]bool) }}
	{{
		for _, md := range managedDevices {
			managedMap[md.MountPoint] = true
		}
	}}
	<div class="device-manager">
		<h3 class="device-manager-title">Storage Device Management</h3>
		<p class="device-manager-description">
			Enable storage devices for Autobutler by creating the required data directory structure.
			Enabled devices will have a <code>.autobutler/data/cirrus</code> directory and will appear in the file explorer for multi-device file management.
		</p>
		<div class="device-manager-list">
			if len(devices) == 0 {
				<div class="device-manager-empty">
					<p>No storage devices detected</p>
				</div>
			}
			for _, device := range devices {
				{{ isManaged := managedMap[device.MountPoint] }}
				<div class="device-manager-item">
					<div class="device-manager-item-icon">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
							<line x1="8" y1="21" x2="16" y2="21"></line>
							<line x1="12" y1="17" x2="12" y2="21"></line>
						</svg>
					</div>
					<div class="device-manager-item-info">
						<h4 class="device-manager-item-name">{ device.Name }</h4>
						<p class="device-manager-item-details">
							{ device.Type } • { device.MountPoint } • { fmt.Sprintf("%.2f GB available", float64(device.AvailBytes)/(1024*1024*1024)) }
						</p>
						if isManaged {
							{{ dataPath := device.MountPoint + "/.autobutler/data/cirrus" }}
							<p class="device-manager-item-status">
								<svg class="device-manager-status-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Data directory: <code>{ dataPath }</code></span>
							</p>
						}
					</div>
					<div class="device-manager-item-actions">
						if isManaged {
							<span class="device-manager-badge device-manager-badge--enabled">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								Enabled
							</span>
						} else {
							<form
								hx-post="/api/v1/storage/managed"
								hx-trigger="submit"
								hx-swap="none"
								hx-on::after-request="if(event.detail.successful) { htmx.trigger('#device-manager-content', 'refresh-devices'); }"
							>
								<input type="hidden" name="mountPoint" value={ device.MountPoint }/>
								<button
									type="submit"
									class="btn btn--primary btn--sm"
									title="Creates .autobutler/data/cirrus directory on this device"
								>
									Enable for Storage
								</button>
							</form>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

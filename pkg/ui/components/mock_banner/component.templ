package mock_banner

// Component renders a banner at the top of the page indicating the page is mock/non-functional
templ Component() {
	<div class="ab-mock-banner">
		<svg class="ab-mock-banner-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"></circle>
			<line x1="12" y1="8" x2="12" y2="12"></line>
			<line x1="12" y1="16" x2="12.01" y2="16"></line>
		</svg>
		<div class="ab-mock-banner-content">
			<strong class="ab-mock-banner-title">Mock UI</strong>
			<span class="ab-mock-banner-text">This page is not functional and can be ignored.</span>
		</div>
	</div>
}

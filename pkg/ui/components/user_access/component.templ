package user_access

import (
	"autobutler/pkg/ui/components/mock_badge"
	"fmt"
	"time"
)

// Component renders the user access control interface
templ Component(users []User, roles []Role, permissions []Permission) {
	<div class="user-access-container">
		<!-- Invite User Section -->
		<section id="invite" class="user-invite-section">
			@mock_badge.Component()
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
					<circle cx="8.5" cy="7" r="4"></circle>
					<line x1="20" y1="8" x2="20" y2="14"></line>
					<line x1="23" y1="11" x2="17" y2="11"></line>
				</svg>
				<h2>Invite User</h2>
			</div>
			<form class="user-invite-form" hx-post="/api/v1/users/invite" hx-target="#user-invite-feedback" hx-swap="innerHTML">
				<div class="user-invite-fields">
					<div class="settings-form-group">
						<label>
							<span>Email Address</span>
							<input type="email" name="email" placeholder="user@example.com" required/>
						</label>
					</div>
					<div class="settings-form-group">
						<label>
							<span>Role</span>
							<select name="role">
								for _, role := range roles {
									<option value={ role.ID }>{ role.Name }</option>
								}
							</select>
						</label>
					</div>
					<div class="settings-form-group">
						<label>
							<span>Message (Optional)</span>
							<textarea name="message" placeholder="Welcome to Autobutler!" rows="2"></textarea>
						</label>
					</div>
				</div>
				<div class="user-invite-actions">
					<button type="submit" class="btn btn--primary">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="22" y1="2" x2="11" y2="13"></line>
							<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
						</svg>
						Send Invitation
					</button>
				</div>
				<div id="user-invite-feedback" class="user-invite-feedback"></div>
			</form>
		</section>
		<!-- Users List Section -->
		<section id="users" class="user-list-section">
			@mock_badge.Component()
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
					<circle cx="9" cy="7" r="4"></circle>
					<path d="M23 21v-2a4 4 0 00-3-3.87"></path>
					<path d="M16 3.13a4 4 0 010 7.75"></path>
				</svg>
				<h2>Users</h2>
			</div>
			<div class="user-list-toolbar">
				<div class="user-list-search">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="M21 21l-4.35-4.35"></path>
					</svg>
					<input type="search" placeholder="Search users by name or email..." name="search"/>
				</div>
				<div class="user-list-filters">
					<select name="filter-role">
						<option value="">All Roles</option>
						for _, role := range roles {
							<option value={ role.ID }>{ role.Name }</option>
						}
					</select>
					<select name="filter-status">
						<option value="">All Status</option>
						<option value="active">Active</option>
						<option value="pending">Pending</option>
						<option value="inactive">Inactive</option>
					</select>
				</div>
			</div>
			if len(users) == 0 {
				<div class="user-list-empty">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
						<circle cx="9" cy="7" r="4"></circle>
						<path d="M23 21v-2a4 4 0 00-3-3.87"></path>
						<path d="M16 3.13a4 4 0 010 7.75"></path>
					</svg>
					<h3>No users yet</h3>
					<p>Invite your first user to get started</p>
				</div>
			} else {
				<div class="user-table-wrapper">
					<table class="user-access-table" role="table">
						<thead>
							<tr>
								<th>User</th>
								<th>Email</th>
								<th>Role</th>
								<th>Status</th>
								<th>Last Active</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, user := range users {
								<tr class="user-table-row">
									<td>
										<div class="user-table-user">
											<div class="user-avatar">{ user.Avatar }</div>
											<span class="user-name">{ user.Name }</span>
										</div>
									</td>
									<td>
										<span class="user-email">{ user.Email }</span>
									</td>
									<td>
										<span class={ fmt.Sprintf("user-role-badge user-role-badge--%s", user.Role) }>
											{ user.Role }
										</span>
									</td>
									<td>
										<span class={ fmt.Sprintf("user-status-badge user-status-badge--%s", user.Status) }>
											switch user.Status {
												case "active":
													<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
														<polyline points="22 4 12 14.01 9 11.01"></polyline>
													</svg>
												case "pending":
													<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<circle cx="12" cy="12" r="10"></circle>
														<polyline points="12 6 12 12 16 14"></polyline>
													</svg>
												default:
													<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<circle cx="12" cy="12" r="10"></circle>
														<line x1="15" y1="9" x2="9" y2="15"></line>
														<line x1="9" y1="9" x2="15" y2="15"></line>
													</svg>
											}
											{ user.Status }
										</span>
									</td>
									<td>
										<span class="user-last-seen">
											if user.Status == "pending" {
												Never
											} else if !user.LastSeen.IsZero() {
												{ formatTimeAgo(user.LastSeen) }
											} else {
												Unknown
											}
										</span>
									</td>
									<td>
										<div class="user-actions">
											if user.Status == "pending" {
												<button class="user-action-btn" title="Resend Invitation" hx-post={ fmt.Sprintf("/api/v1/users/%s/resend", user.ID) } hx-swap="none">
													<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<line x1="22" y1="2" x2="11" y2="13"></line>
														<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
													</svg>
												</button>
											}
											<button class="user-action-btn" title="Edit Role" aria-label="Edit user role">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path>
													<path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"></path>
												</svg>
											</button>
											<button class="user-action-btn user-action-btn--danger" title="Revoke Access" hx-delete={ fmt.Sprintf("/api/v1/users/%s", user.ID) } hx-confirm="Are you sure you want to revoke access for this user?" hx-swap="none">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<polyline points="3 6 5 6 21 6"></polyline>
													<path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path>
												</svg>
											</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<!-- Roles Management Section -->
		<section id="roles" class="roles-section">
			@mock_badge.Component()
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
				</svg>
				<h2>Roles</h2>
			</div>
			<div class="role-card-grid">
				for _, role := range roles {
					<div class="role-card">
						<div class="role-card-header">
							<h3>{ role.Name }</h3>
							<span class="role-user-count">{ fmt.Sprintf("%d users", role.UserCount) }</span>
						</div>
						<p class="role-card-description">{ role.Description }</p>
						<div class="role-card-permissions">
							<strong>{ fmt.Sprintf("%d permissions", len(role.Permissions)) }</strong>
							<div class="role-permission-list">
								for i, perm := range role.Permissions {
									if i < 3 {
										<span class="role-permission-tag">{ perm }</span>
									}
								}
								if len(role.Permissions) > 3 {
									<span class="role-permission-more">+{ fmt.Sprintf("%d more", len(role.Permissions)-3) }</span>
								}
							</div>
						</div>
						<div class="role-card-actions">
							<button class="btn btn--sm">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path>
									<path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"></path>
								</svg>
								Edit Permissions
							</button>
						</div>
					</div>
				}
				<div class="role-card role-card--create">
					<div class="role-card-create-content">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="12" y1="8" x2="12" y2="16"></line>
							<line x1="8" y1="12" x2="16" y2="12"></line>
						</svg>
						<h3>Create Custom Role</h3>
						<p>Define custom permissions for specific use cases</p>
					</div>
				</div>
			</div>
		</section>
		<!-- Permission Matrix Section -->
		<section id="permissions" class="permissions-section">
			@mock_badge.Component()
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
					<path d="M7 11V7a5 5 0 0110 0v4"></path>
				</svg>
				<h2>Permission Matrix</h2>
			</div>
			<p class="settings-section-description">
				Configure which roles have access to specific resources and actions.
			</p>
			<div class="permission-matrix-wrapper">
				<table class="permission-matrix" role="table">
					<thead>
						<tr>
							<th>Resource</th>
							for _, role := range roles {
								<th>
									<div class="permission-matrix-role-header">
										<span>{ role.Name }</span>
									</div>
								</th>
							}
						</tr>
					</thead>
					<tbody>
						{{ groupedPerms := GroupPermissionsByResource(permissions) }}
						for resource, perms := range groupedPerms {
							<tr class="permission-matrix-resource-header">
								<td colspan={ fmt.Sprintf("%d", len(roles)+1) }>
									<strong>{ resource }</strong>
								</td>
							</tr>
							for _, perm := range perms {
								<tr class="permission-matrix-row">
									<td class="permission-matrix-label">
										<div class="permission-info">
											<span class="permission-name">{ perm.Name }</span>
											<span class="permission-description">{ perm.Description }</span>
										</div>
									</td>
									for _, role := range roles {
										<td class="permission-matrix-cell">
											{{ hasPermission := RoleHasPermission(role, perm.ID) }}
											<label class="permission-checkbox">
												if hasPermission {
													<input type="checkbox" checked hx-post={ fmt.Sprintf("/api/v1/roles/%s/permissions/%s", role.ID, perm.ID) } hx-trigger="change" hx-swap="none"/>
												} else {
													<input type="checkbox" hx-post={ fmt.Sprintf("/api/v1/roles/%s/permissions/%s", role.ID, perm.ID) } hx-trigger="change" hx-swap="none"/>
												}
												<span class="permission-checkbox-icon">
													<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
														<polyline points="20 6 9 17 4 12"></polyline>
													</svg>
												</span>
											</label>
										</td>
									}
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

func formatTimeAgo(t time.Time) string {
	duration := time.Since(t)

	if duration < time.Minute {
		return "Just now"
	} else if duration < time.Hour {
		minutes := int(duration.Minutes())
		if minutes == 1 {
			return "1 minute ago"
		}
		return fmt.Sprintf("%d minutes ago", minutes)
	} else if duration < 24*time.Hour {
		hours := int(duration.Hours())
		if hours == 1 {
			return "1 hour ago"
		}
		return fmt.Sprintf("%d hours ago", hours)
	} else if duration < 7*24*time.Hour {
		days := int(duration.Hours() / 24)
		if days == 1 {
			return "1 day ago"
		}
		return fmt.Sprintf("%d days ago", days)
	} else {
		return t.Format("Jan 2, 2006")
	}
}

package rename_dialog

templ Component() {
	<dialog
		id="rename-dialog"
		class="dialog rename-dialog"
		onkeydown="if (event.key === 'Escape') { event.preventDefault(); this.close(); }"
		onclick="if (event.target === this) { this.close(); }"
	>
		<button
			class="dialog-close rename-dialog-close"
			aria-label="Close"
			onclick="document.getElementById('rename-dialog').close()"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 20 20">
				<path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M5 5l10 10M15 5l-10 10"></path>
			</svg>
		</button>
		<div class="dialog-content rename-dialog-content">
			<div class="rename-header">
				<h3 class="rename-title">Rename/Move File</h3>
				<p class="rename-subtitle" id="rename-current-path"></p>
			</div>
			<form class="rename-form" id="rename-form">
				<div class="rename-confirm rename-hidden" id="rename-confirm">
					<p class="rename-confirm-text">Are you sure you want to rename/move this file?</p>
					<div class="rename-confirm-path" id="rename-confirm-from"></div>
					<div class="rename-confirm-path" id="rename-confirm-to"></div>
				</div>
				<div class="rename-input-group" id="rename-input-group">
					<label class="rename-label" for="rename-path-input">
						New path (including filename and extension):
					</label>
					<input
						type="text"
						id="rename-path-input"
						class="rename-input"
						value=""
						maxlength="255"
						required
					/>
				</div>
				<div class="rename-actions">
					<button type="button" class="btn btn--secondary" id="rename-cancel">
						Cancel
					</button>
					<button type="submit" class="btn btn--primary" id="rename-submit">
						Rename
					</button>
				</div>
			</form>
		</div>
	</dialog>
}

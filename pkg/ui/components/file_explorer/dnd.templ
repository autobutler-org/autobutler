package file_explorer

import "autobutler/pkg/ui/types"

templ dnd(pageState types.PageState) {
	<div
		id="file-upload-area"
		class="dnd-overlay"
		ondragenter="window.ab.activateDropZone(event)"
		ondragover="window.ab.preventDefault(event)"
		ondragleave="window.ab.deactivateDropZone(event)"
		ondrop={ templ.JSFuncCall("window.ab.dropFiles", templ.JSExpression("event"), "", pageState.RootDir) }
		onclick="document.getElementById('file-upload-input').click()"
	>
		Drop files here&#8230;
	</div>
}

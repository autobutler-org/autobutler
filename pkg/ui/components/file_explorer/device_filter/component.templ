package device_filter

import (
	"autobutler/pkg/util/storageutil"
	"autobutler/pkg/ui/types"
)

templ Component(pageState types.PageState) {
	{{ managedDevices, err := storageutil.GetManagedDevices() }}
	if err == nil && len(managedDevices) > 1 {
		<div class="device-filter">
			<label class="device-filter-label">Devices:</label>
			<div class="device-filter-buttons">
				for _, device := range managedDevices {
					<button
						class="device-filter-button device-filter-button--active"
						data-device-name={ device.Name }
						data-device-path={ device.MountPoint }
						onclick="toggleDeviceFilter(this)"
						title={ "Toggle " + device.Name }
						type="button"
					>
						<svg class="device-filter-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
							<line x1="8" y1="21" x2="16" y2="21"></line>
							<line x1="12" y1="17" x2="12" y2="21"></line>
						</svg>
						<span class="device-filter-name">{ device.Name }</span>
					</button>
				}
			</div>
		</div>
	}
}

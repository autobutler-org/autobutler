package network_settings

import (
	"fmt"
	"time"
)

// Component renders the network settings interface
templ Component(status NetworkStatus, devices []TailnetDevice, pending []PendingDevice, config NetworkConfig) {
	<div class="network-settings-container">
		<!-- Connection Status Section -->
		<section id="status" class="network-status-section">
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="2" y1="12" x2="22" y2="12"></line>
					<path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
				</svg>
				<h2>VPN Connection Status</h2>
			</div>
			<div class="network-status-card">
				<div class="network-status-indicator">
					if status.Connected {
						<div class="network-status-icon network-status-icon--connected">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
								<polyline points="22 4 12 14.01 9 11.01"></polyline>
							</svg>
						</div>
						<div class="network-status-text">
							<h3>Connected</h3>
							<p>Your network is secure and accessible</p>
						</div>
					} else {
						<div class="network-status-icon network-status-icon--disconnected">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="15" y1="9" x2="9" y2="15"></line>
								<line x1="9" y1="9" x2="15" y2="15"></line>
							</svg>
						</div>
						<div class="network-status-text">
							<h3>Disconnected</h3>
							<p>Connect to access your network remotely</p>
						</div>
					}
				</div>
				if status.Connected {
					<div class="network-status-details">
						<div class="network-status-detail-item">
							<span class="network-status-label">IP Address</span>
							<span class="network-status-value">{ status.IPAddress }</span>
						</div>
						<div class="network-status-detail-item">
							<span class="network-status-label">Hostname</span>
							<span class="network-status-value">{ status.Hostname }</span>
						</div>
						<div class="network-status-detail-item">
							<span class="network-status-label">Connected Since</span>
							<span class="network-status-value">{ formatTimeAgo(status.LastConnected) }</span>
						</div>
					</div>
				}
				<div class="network-status-actions">
					if status.Connected {
						<button class="btn btn--danger" hx-post="/api/v1/network/disconnect" hx-swap="none">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<line x1="18" y1="6" x2="6" y2="18"></line>
								<line x1="6" y1="6" x2="18" y2="18"></line>
							</svg>
							Disconnect
						</button>
					} else {
						<button class="btn btn--primary" hx-post="/api/v1/network/connect" hx-swap="none">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M22 11.08V12a10 10 0 11-5.93-9.14"></path>
								<polyline points="22 4 12 14.01 9 11.01"></polyline>
							</svg>
							Connect
						</button>
					}
					<button class="btn btn--secondary">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polyline points="23 4 23 10 17 10"></polyline>
							<path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"></path>
						</svg>
						Refresh
					</button>
				</div>
			</div>
		</section>
		<!-- Network Configuration Section -->
		<section id="config" class="network-config-section">
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M12 15a3 3 0 100-6 3 3 0 000 6z"></path>
					<path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"></path>
				</svg>
				<h2>Network Configuration</h2>
			</div>
			<div class="network-config-grid">
				<div class="network-config-card">
					<h3>General Settings</h3>
					<div class="settings-checkbox-group">
						<input type="checkbox" id="vpn-enabled" checked?={ config.VPNEnabled } hx-post="/api/v1/network/config/vpn-enabled" hx-trigger="change" hx-swap="none"/>
						<label for="vpn-enabled">
							<span>Enable VPN</span>
							<span>Allow remote access to your Autobutler instance</span>
						</label>
					</div>
					<div class="settings-checkbox-group">
						<input type="checkbox" id="auto-connect" checked?={ config.AutoConnect } hx-post="/api/v1/network/config/auto-connect" hx-trigger="change" hx-swap="none"/>
						<label for="auto-connect">
							<span>Auto-connect on startup</span>
							<span>Automatically connect when Autobutler starts</span>
						</label>
					</div>
				<div class="settings-checkbox-group">
					<input type="checkbox" id="magic-dns" checked?={ config.MagicDNSEnabled } hx-post="/api/v1/network/config/magic-dns" hx-trigger="change" hx-swap="none"/>
					<label for="magic-dns">
						<span>Enable MagicDNS</span>
						<span>Use device names instead of IP addresses</span>
					</label>
				</div>
				<div class="settings-checkbox-group">
					<input type="checkbox" id="exit-node-host" checked?={ config.IsExitNode } hx-post="/api/v1/network/config/exit-node-host" hx-trigger="change" hx-swap="none"/>
					<label for="exit-node-host">
						<span>Act as exit node</span>
						<span>Allow other devices to route traffic through this device</span>
					</label>
				</div>
			</div>
				<div class="network-config-card">
					<h3>Advanced Settings</h3>
					<div class="settings-form-group">
						<label>
							<span>Exit Node</span>
							<select name="exit-node" hx-post="/api/v1/network/config/exit-node" hx-trigger="change" hx-swap="none">
								<option value="" selected?={ config.ExitNode == "" }>None</option>
								<option value="us-nyc" selected?={ config.ExitNode == "us-nyc" }>US - New York</option>
								<option value="us-sfo" selected?={ config.ExitNode == "us-sfo" }>US - San Francisco</option>
								<option value="eu-lon" selected?={ config.ExitNode == "eu-lon" }>EU - London</option>
								<option value="ap-syd" selected?={ config.ExitNode == "ap-syd" }>AP - Sydney</option>
							</select>
						</label>
					</div>
					<div class="settings-checkbox-group">
						<input type="checkbox" id="accept-routes" checked?={ config.AcceptRoutes } hx-post="/api/v1/network/config/accept-routes" hx-trigger="change" hx-swap="none"/>
						<label for="accept-routes">
							<span>Accept subnet routes</span>
							<span>Access subnet routes advertised by other devices</span>
						</label>
					</div>
					<div class="settings-form-group">
						<label>
							<span>Advertise Routes</span>
							<input type="text" name="advertise-routes" value={ config.AdvertiseRoutes } placeholder="192.168.1.0/24"/>
						</label>
					</div>
				</div>
			</div>
		</section>
		<!-- Connected Devices Section -->
		<section id="devices" class="network-devices-section">
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
					<line x1="8" y1="21" x2="16" y2="21"></line>
					<line x1="12" y1="17" x2="12" y2="21"></line>
				</svg>
				<h2>Connected Devices</h2>
			</div>
			<p class="settings-section-description">
				Devices connected to your private network. You can access Autobutler from any of these devices.
			</p>
			if len(devices) == 0 {
				<div class="network-devices-empty">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
						<line x1="8" y1="21" x2="16" y2="21"></line>
						<line x1="12" y1="17" x2="12" y2="21"></line>
					</svg>
					<h3>No devices connected</h3>
					<p>Connect your first device to get started</p>
				</div>
			} else {
				<div class="network-devices-grid">
					for _, device := range devices {
						<div class="network-device-card">
							<div class="network-device-header">
								<div class="network-device-icon">
									if device.OS == "macOS" || device.OS == "Windows" || device.OS == "Linux" {
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
											<line x1="8" y1="21" x2="16" y2="21"></line>
											<line x1="12" y1="17" x2="12" y2="21"></line>
										</svg>
									} else if device.OS == "iOS" || device.OS == "Android" {
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
											<line x1="12" y1="18" x2="12.01" y2="18"></line>
										</svg>
									} else {
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
											<path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"></path>
										</svg>
									}
								</div>
								<div class="network-device-status">
									if device.Online {
										<span class="network-device-status-dot network-device-status-dot--online"></span>
									} else {
										<span class="network-device-status-dot network-device-status-dot--offline"></span>
									}
								</div>
							</div>
							<div class="network-device-info">
								<h4>
									{ device.Name }
									if device.CurrentDevice {
										<span class="network-device-badge">This Device</span>
									}
								</h4>
								<div class="network-device-details">
									<span class="network-device-detail">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"></circle>
											<line x1="2" y1="12" x2="22" y2="12"></line>
											<path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
										</svg>
										{ device.IPAddress }
									</span>
									<span class="network-device-detail">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
											<line x1="8" y1="21" x2="16" y2="21"></line>
											<line x1="12" y1="17" x2="12" y2="21"></line>
										</svg>
										{ device.OS }
									</span>
								</div>
								<div class="network-device-last-seen">
									if device.Online {
										<span class="network-device-online-text">Active now</span>
									} else {
										Last seen { formatTimeAgo(device.LastSeen) }
									}
								</div>
							</div>
						</div>
					}
				</div>
			}
		</section>
		<!-- Pending Devices Section -->
		if len(pending) > 0 {
			<section id="pending" class="network-pending-section">
				<div class="settings-section-header">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"></circle>
						<polyline points="12 6 12 12 16 14"></polyline>
					</svg>
					<h2>Pending Authorization</h2>
				</div>
				<p class="settings-section-description">
					Devices waiting for authorization to join your network. Review and approve trusted devices.
				</p>
				<div class="network-pending-list">
					for _, device := range pending {
						<div class="network-pending-card">
							<div class="network-pending-icon">
								if device.OS == "macOS" || device.OS == "Windows" || device.OS == "Linux" {
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
										<line x1="8" y1="21" x2="16" y2="21"></line>
										<line x1="12" y1="17" x2="12" y2="21"></line>
									</svg>
								} else {
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
										<line x1="12" y1="18" x2="12.01" y2="18"></line>
									</svg>
								}
							</div>
							<div class="network-pending-info">
								<h4>{ device.Name }</h4>
								<div class="network-pending-details">
									<span class="network-device-detail">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
											<line x1="8" y1="21" x2="16" y2="21"></line>
											<line x1="12" y1="17" x2="12" y2="21"></line>
										</svg>
										{ device.OS }
									</span>
									<span class="network-device-last-seen">
										Requested { formatTimeAgo(device.RequestedAt) }
									</span>
								</div>
							</div>
							<div class="network-pending-actions">
								<button class="btn btn--primary btn--sm" hx-post={ fmt.Sprintf("/api/v1/network/devices/%s/authorize", device.ID) } hx-swap="none">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									Approve
								</button>
								<button class="btn btn--danger btn--sm" hx-delete={ fmt.Sprintf("/api/v1/network/devices/%s", device.ID) } hx-swap="none">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<line x1="18" y1="6" x2="6" y2="18"></line>
										<line x1="6" y1="6" x2="18" y2="18"></line>
									</svg>
									Reject
								</button>
							</div>
						</div>
					}
				</div>
			</section>
		}
		<!-- Installation Instructions -->
		<section id="install" class="network-install-section">
			<div class="settings-section-header">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10"></circle>
					<line x1="12" y1="8" x2="12" y2="16"></line>
					<line x1="8" y1="12" x2="16" y2="12"></line>
				</svg>
				<h2>Add New Device</h2>
			</div>
			<p class="settings-section-description">
				Install the VPN client on your device to connect it to your private network. Choose your platform below for installation instructions.
			</p>
			<div class="network-install-grid">
				<!-- iOS -->
				<div class="network-install-card">
					<div class="network-install-icon network-install-icon--ios">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
							<path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
						</svg>
					</div>
					<h3>iOS / iPadOS</h3>
					<ol class="network-install-steps">
						<li>Open the <strong>App Store</strong></li>
						<li>Search for <strong>Tailscale</strong></li>
						<li>Tap <strong>Get</strong> to install</li>
						<li>Open the app and sign in</li>
						<li>Connect to join your network</li>
					</ol>
					<a href="https://apps.apple.com/us/app/tailscale/id1470499037" target="_blank" class="btn btn--secondary btn--sm">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path>
							<polyline points="15 3 21 3 21 9"></polyline>
							<line x1="10" y1="14" x2="21" y2="3"></line>
						</svg>
						Open App Store
					</a>
				</div>
				<!-- Android -->
				<div class="network-install-card">
					<div class="network-install-icon network-install-icon--android">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
							<path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85a.637.637 0 00-.83.22l-1.88 3.24a11.43 11.43 0 00-8.94 0L5.65 5.67a.643.643 0 00-.87-.22c-.28.18-.37.54-.22.83L6.4 9.48A10.81 10.81 0 001 18h22a10.81 10.81 0 00-5.4-8.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z"/>
						</svg>
					</div>
					<h3>Android</h3>
					<ol class="network-install-steps">
						<li>Open <strong>Google Play Store</strong></li>
						<li>Search for <strong>Tailscale</strong></li>
						<li>Tap <strong>Install</strong></li>
						<li>Open the app and sign in</li>
						<li>Connect to join your network</li>
					</ol>
					<a href="https://play.google.com/store/apps/details?id=com.tailscale.ipn" target="_blank" class="btn btn--secondary btn--sm">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path>
							<polyline points="15 3 21 3 21 9"></polyline>
							<line x1="10" y1="14" x2="21" y2="3"></line>
						</svg>
						Open Play Store
					</a>
				</div>
				<!-- macOS -->
				<div class="network-install-card">
					<div class="network-install-icon network-install-icon--mac">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
							<path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
						</svg>
					</div>
					<h3>macOS</h3>
					<ol class="network-install-steps">
						<li>Open the <strong>Mac App Store</strong></li>
						<li>Search for <strong>Tailscale</strong></li>
						<li>Click <strong>Get</strong> to install</li>
						<li>Open from Applications and sign in</li>
						<li>Click <strong>Connect</strong> in the menu bar</li>
					</ol>
					<a href="https://apps.apple.com/us/app/tailscale/id1475387142" target="_blank" class="btn btn--secondary btn--sm">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

package view_home

import (
	"autobutler/pkg/ui/components/footer"
	"autobutler/pkg/ui/components/gradient_overlays"
	"autobutler/pkg/ui/components/header"
	"autobutler/pkg/ui/components/hero"
	"autobutler/pkg/ui/components/top_nav"
	"autobutler/pkg/ui/types"
	"autobutler/pkg/util/cirrusutil"
)

templ Home(pageState types.PageState, summary cirrusutil.Summary) {
	{{ pageState.CurrentPageName = types.PageHome }}
	<!DOCTYPE html>
	<html lang="en">
		@header.Component()
		<body class="landing-body">
			<main class="landing-main">
				@gradient_overlays.Component()
				<div class="landing-container">
					@top_nav.Component(pageState)
					@hero.Component()
				</div>
			</main>
			@footer.Component()
		</body>
	</html>
}

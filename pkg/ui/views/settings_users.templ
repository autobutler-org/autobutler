package views

import (
	"autobutler/pkg/ui/components/gradient_overlays"
	"autobutler/pkg/ui/components/header"
	"autobutler/pkg/ui/components/landing_nav"
	"autobutler/pkg/ui/components/mock_banner"
	"autobutler/pkg/ui/types"
)

templ SettingsUsers(pageState types.PageState) {
	{{ pageState.CurrentPageName = types.PageSettings }}
	<!DOCTYPE html>
	<html lang="en">
		@header.Component()
		<body class="landing-body">
			<main class="landing-main">
				@gradient_overlays.Component()
				<div class="landing-container">
					@landing_nav.Component(pageState)
					<div class="settings-page">
						@mock_banner.Component()
						<div class="settings-header">
							<div class="settings-header-title">
								<a href="/settings" class="settings-back-link">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<line x1="19" y1="12" x2="5" y2="12"></line>
										<polyline points="12 19 5 12 12 5"></polyline>
									</svg>
								</a>
								<h1>Users & Access Control</h1>
							</div>
							<div class="settings-header-actions">
								<button aria-label="Refresh">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<polyline points="23 4 23 10 17 10"></polyline>
										<path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"></path>
									</svg>
								</button>
							</div>
						</div>
						<div class="settings-layout">
							<aside class="settings-sidebar">
								<nav>
									<h2>Quick Links</h2>
									<ul>
										<li>
											<a href="#invite">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
													<circle cx="8.5" cy="7" r="4"></circle>
													<line x1="20" y1="8" x2="20" y2="14"></line>
													<line x1="23" y1="11" x2="17" y2="11"></line>
												</svg>
												<span>Invite User</span>
											</a>
										</li>
										<li>
											<a href="#users">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
													<circle cx="9" cy="7" r="4"></circle>
													<path d="M23 21v-2a4 4 0 00-3-3.87"></path>
													<path d="M16 3.13a4 4 0 010 7.75"></path>
												</svg>
												<span>Users</span>
											</a>
										</li>
										<li>
											<a href="#roles">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
												</svg>
												<span>Roles</span>
											</a>
										</li>
										<li>
											<a href="#permissions">
												<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
													<path d="M7 11V7a5 5 0 0110 0v4"></path>
												</svg>
												<span>Permissions</span>
											</a>
										</li>
									</ul>
								</nav>
								<div class="settings-sidebar-info">
									<h2>About Access Control</h2>
									<p>Manage who can access your Autobutler instance and what they can do. Configure roles and permissions to maintain security.</p>
								</div>
							</aside>
							<div class="settings-content">
								<div
									id="user-access-content"
									hx-get="/components/settings/user-access"
									hx-trigger="load"
									hx-swap="innerHTML"
								>
									<div style="text-align: center; padding: 4rem; color: var(--color-gray-500);">
										<svg style="width: 48px; height: 48px; margin: 0 auto 1rem; opacity: 0.5;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<line x1="12" y1="2" x2="12" y2="6"></line>
											<line x1="12" y1="18" x2="12" y2="22"></line>
											<line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
											<line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
											<line x1="2" y1="12" x2="6" y2="12"></line>
											<line x1="18" y1="12" x2="22" y2="12"></line>
											<line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
											<line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
										</svg>
										<p>Loading user access control...</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</main>
		</body>
	</html>
}

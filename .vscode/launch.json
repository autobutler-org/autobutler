  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/autobutler/main.go",
      "args": [
        "serve",
      ],
      "envFile": "${workspaceFolder}/.env",
    },
    {
      "name": "Debug lsusb",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/lsusb/main.go",
      "args": [
        "-storage",
      ]
    },
  ]
}

  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/autobutler/main.go",
      "args": [
        "serve",
      ],
      "envFile": "${workspaceFolder}/.env",
    },
    {
      "name": "Debug: frontend",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart"
    }
  ]
}
